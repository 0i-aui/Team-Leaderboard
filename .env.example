VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# Public VAPID key for Web Push subscriptions (public by design — it ships
# in the frontend bundle, like the anon key above).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# NEVER put SUPABASE_SERVICE_ROLE_KEY here. Frontend is read-only.
# NEVER put VAPID_PRIVATE_KEY or PUSH_WEBHOOK_SECRET here either.
# Server-only values (Vercel → Project → Settings → Environment Variables):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, PUSH_WEBHOOK_SECRET
# Put your REAL values in a local .env file (gitignored) — never in this file.
